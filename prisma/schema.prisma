generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Global restaurant configuration — the single source of truth for the site.
/// Only one active record exists (singleton: id = 1, upserted on every save).
model RestaurantSettings {
  id              Int      @id @default(1)
  isActive        Boolean  @default(true)

  // 1 — Restaurant Information
  restaurantName  String   @db.VarChar(120)
  tagline         String   @default("") @db.VarChar(200)
  shortDescription String  @default("") @db.VarChar(500)
  longDescription String   @db.Text
  logoUrl         String   @default("")
  faviconUrl      String   @default("")

  // 2 — Contact Information
  primaryPhone    String   @default("") @db.VarChar(40)
  secondaryPhone  String   @default("") @db.VarChar(40)
  whatsappNumber  String   @default("") @db.VarChar(40)
  email           String   @default("") @db.VarChar(160)

  // 3 — Business Hours (JSON: [{ day, open, close, closed }] for Mon–Sun)
  businessHours   Json

  // 4 — Social Media (JSON: { facebook: { url, enabled }, ... })
  socialMedia     Json
  // 5 — SEO
  metaTitle       String   @default("") @db.VarChar(200)
  metaDescription String   @default("") @db.VarChar(400)
  keywords        String   @default("") @db.VarChar(400)
  ogImageUrl      String   @default("")

  // 6 — Theme
  darkModeDefault Boolean  @default(false)
  accentColor     String   @default("#c9a227") @db.VarChar(9)
  primaryColor    String   @default("#1a1a1a") @db.VarChar(9)
  secondaryColor  String   @default("#f4f4f2") @db.VarChar(9)

  // 7 — Location
  mapsEmbedUrl    String   @default("")
  latitude        Float    @default(0)
  longitude       Float    @default(0)

  // 8 — Admin Account (single-owner sign-in; seeded from env on first login)
  adminName        String    @default("") @db.VarChar(120)
  adminEmail       String    @default("") @db.VarChar(160)
  adminPasswordHash String   @default("") @db.VarChar(512)
  lastLoginAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// A dish on the restaurant menu. Categories are free-form labels so the owner
/// can add unlimited categories over time without schema changes.
model MenuItem {
  id           Int      @id @default(autoincrement())
  category     String   @db.VarChar(80)
  name         String   @db.VarChar(160)
  description  String   @db.Text
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String   @default("") @db.VarChar(500)
  available    Boolean  @default(true)
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([available])
  @@index([featured])
  @@index([displayOrder])
}

/// A named category shown in the menu manager. Menu items reference these by
/// display name (MenuItem.category stays a free-form label for compatibility).
model MenuCategory {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(80)
  slug         String   @unique @db.VarChar(80)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

/// A photo in the gallery. The public masonry grid renders these, showing only
/// visible items — featured first, then display order. `aspect` keeps the
/// editorial masonry proportions even before the browser knows the image size.
model GalleryItem {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(160)
  description  String   @db.Text
  imageUrl     String   @default("") @db.VarChar(500)
  aspect       String   @default("4 / 3") @db.VarChar(24)
  displayOrder Int      @default(0)
  featured     Boolean  @default(false)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([featured])
  @@index([visible])
}

/// A nearby tourist attraction. The public editorial travel cards render these,
/// showing only visible items — featured first, then display order. `slug` is
/// auto-generated from the name on create and kept stable on edit.
model Attraction {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(160)
  slug         String   @unique @db.VarChar(160)
  description  String   @db.Text
  imageUrl     String   @default("") @db.VarChar(500)
  mapUrl       String   @default("") @db.VarChar(1000)
  rating       Decimal  @default(0) @db.Decimal(2, 1)
  travelTime   String   @default("") @db.VarChar(80)
  displayOrder Int      @default(0)
  featured     Boolean  @default(false)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([featured])
  @@index([visible])
}

/// A customer review. The public review cards render these, showing only visible
/// reviews — featured first, then display order. `reviewDate` is the free-text
/// label shown on the card (e.g. "2 weeks ago") so the owner controls the wording.
model Review {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  imageUrl     String   @default("") @db.VarChar(500)
  rating       Int      @default(5)
  text         String   @db.Text
  reviewDate   String   @default("Verified review") @db.VarChar(120)
  displayOrder Int      @default(0)
  featured     Boolean  @default(false)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([featured])
  @@index([visible])
  @@index([rating])
}

/// A physical restaurant outlet. The public branches, location, contact and
/// footer sections all read from these — visible branches are shown on the
/// site (featured first), and the featured branch drives the contact details
/// (phones, WhatsApp, email, addresses and opening hours) shown across the
/// page. `hours` is a JSON array of { day, open, close, closed } for Mon–Sun.
model Branch {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(160)
  slug           String   @unique @db.VarChar(160)
  imageUrl       String   @default("") @db.VarChar(500)
  address        String   @db.VarChar(500)
  mapsUrl        String   @default("") @db.VarChar(1000)
  latitude       Float    @default(0)
  longitude      Float    @default(0)
  primaryPhone   String   @db.VarChar(40)
  secondaryPhone String   @default("") @db.VarChar(40)
  whatsapp       String   @default("") @db.VarChar(40)
  email          String   @default("") @db.VarChar(160)
  hours          Json
  description    String   @db.Text
  displayOrder   Int      @default(0)
  featured       Boolean  @default(false)
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([displayOrder])
  @@index([featured])
  @@index([visible])
}

/// A customer enquiry submitted from the public contact form. Every message
/// lands here and is managed from the admin dashboard. `number` is the
/// human-facing reference (CM-0001) assigned automatically on create. `status`
/// drives the inbox workflow: NEW → READ → REPLIED → CLOSED (or SPAM), and the
/// matching repliedAt/closedAt timestamps are set once and never overwritten.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  number    String   @unique @db.VarChar(20)
  name      String   @db.VarChar(120)
  phone     String   @db.VarChar(40)
  email     String   @default("") @db.VarChar(160)
  subject   String   @db.VarChar(200)
  message   String   @db.Text
  branch    String   @default("") @db.VarChar(160)
  status    String   @default("NEW") @db.VarChar(20)
  notes     String   @db.Text
  repliedAt DateTime?
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

/// A table reservation submitted from the public website. Every booking lands
/// here and is managed from the admin dashboard. `number` is the human-facing
/// reservation code (KB-0001) assigned automatically on create. `date`/`time`
/// are the guest's chosen slot (YYYY-MM-DD / HH:MM, local). `status` drives the
/// admin workflow: PENDING → CONFIRMED → COMPLETED (or CANCELLED / NO_SHOW),
/// and the corresponding confirmedAt/completedAt/cancelledAt timestamps are set
/// once and never overwritten.
model Reservation {
  id          Int      @id @default(autoincrement())
  number      String   @unique @db.VarChar(20)
  name        String   @db.VarChar(120)
  phone       String   @db.VarChar(40)
  email       String   @default("") @db.VarChar(160)
  branch      String   @default("") @db.VarChar(160)
  guests      Int
  date        String   @db.VarChar(10)
  time        String   @db.VarChar(5)
  occasion    String   @default("") @db.VarChar(80)
  request     String   @db.Text
  status      String   @default("PENDING") @db.VarChar(20)
  notes       String   @db.Text
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([date])
  @@index([phone])
  @@index([branch])
}

/// A frequently asked question. The public FAQ accordion renders these,
/// showing only visible FAQs — featured first, then display order. When no
/// visible FAQs exist the site falls back to the built-in static list, so the
/// section is never empty during development.
model Faq {
  id           Int      @id @default(autoincrement())
  question     String   @db.VarChar(300)
  answer       String   @db.Text
  category     String   @default("") @db.VarChar(80)
  featured     Boolean  @default(false)
  visible      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([featured])
  @@index([visible])
  @@index([category])
}

/// The central SEO control panel — the single source of truth for every
/// search, social and crawler setting on the public website.
/// Only one active record exists (singleton: id = 1, upserted on every save).
model SiteSEO {
  id                        Int      @id @default(1)
  siteTitle                 String   @default("") @db.VarChar(200)
  metaTitle                 String   @default("") @db.VarChar(200)
  metaDescription           String   @default("") @db.VarChar(400)
  keywords                  String   @default("") @db.VarChar(400)
  canonicalUrl              String   @default("") @db.VarChar(500)
  ogTitle                   String   @default("") @db.VarChar(200)
  ogDescription             String   @default("") @db.VarChar(400)
  ogImage                   String   @default("") @db.VarChar(500)
  twitterTitle              String   @default("") @db.VarChar(200)
  twitterDescription        String   @default("") @db.VarChar(400)
  twitterImage              String   @default("") @db.VarChar(500)
  googleAnalyticsId         String   @default("") @db.VarChar(40)
  googleTagManagerId        String   @default("") @db.VarChar(40)
  googleSiteVerification    String   @default("") @db.VarChar(200)
  facebookDomainVerification String  @default("") @db.VarChar(200)
  robotsIndex               Boolean  @default(true)
  robotsFollow              Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

/// A blog post on the public site. The `/blog` index renders only published
/// posts — featured first, then display order — and `/blog/[slug]` renders the
/// full article. `slug` is auto-generated from the title on create and kept
/// stable on edit. `content` is markdown-ready and `tags` is a comma-separated
/// string so the owner can type tags freely without schema changes.
model BlogPost {
  id             Int      @id @default(autoincrement())
  title          String   @db.VarChar(200)
  slug           String   @unique @db.VarChar(220)
  excerpt        String   @db.Text
  content        String   @db.Text
  coverImage     String   @default("") @db.VarChar(500)
  category       String   @default("") @db.VarChar(80)
  tags           String   @default("") @db.VarChar(400)
  author         String   @default("") @db.VarChar(120)
  featured       Boolean  @default(false)
  published      Boolean  @default(false)
  publishedAt    DateTime?
  displayOrder   Int      @default(0)
  seoTitle       String   @default("") @db.VarChar(200)
  seoDescription String   @default("") @db.VarChar(400)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([displayOrder])
  @@index([featured])
  @@index([published])
  @@index([publishedAt])
  @@index([category])
}
